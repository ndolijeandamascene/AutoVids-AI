# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/autovids_ai

# AI API Keys
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Text-to-Speech
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# TikTok (Optional - for API access)
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# Celery & Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Media Storage
MEDIA_ROOT=media/
STATIC_ROOT=staticfiles/

# Content Settings
DEFAULT_AI_PROVIDER=openai
DEFAULT_TTS_PROVIDER=elevenlabs
MAX_VIDEOS_PER_DAY=2
MIN_HOURS_BETWEEN_POSTS=8

# Safety Settings
ACCOUNT_AGE_DAYS_BEFORE_AUTO=7
ENABLE_HUMAN_BEHAVIOR=True
RANDOM_DELAY_MIN_SECONDS=30
RANDOM_DELAY_MAX_SECONDS=180

# Monitoring
SENTRY_DSN=your-sentry-dsn
